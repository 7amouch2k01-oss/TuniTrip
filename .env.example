# ==============================================================================
# TuniTrip / NOVA — Production AI Orchestrator Environment Configuration
# ==============================================================================
# IMPORTANT: All API keys must remain strictly SERVER-SIDE.
# Never expose secrets in client-side code or browser bundles.

# ------------------------------------------------------------------------------
# 1. Primary Model Provider & Model Hierarchy
# ------------------------------------------------------------------------------
# Provider choice: 'openai' | 'gemini' | 'anthropic' | 'local'
PRIMARY_MODEL_PROVIDER=gemini

# Specific Model Configurations (OpenAI)
FAST_MODEL=gpt-4o-mini
REASONING_MODEL=gpt-4o
RESEARCH_MODEL=gpt-4o

# Specific Model Configurations (Google Gemini)
GEMINI_MODEL=gemini-1.5-flash

# Specific Model Configurations (Anthropic Claude)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 2. LLM Provider API Keys (Server-Side Only)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 3. Search & Places Grounding API Keys
# ------------------------------------------------------------------------------
# Google Maps Platform (Places API New, Routes API, Distance Matrix)
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Web Search API (Tavily or Serper for live web grounding)
SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# ------------------------------------------------------------------------------
# 4. Supabase Backend & Vector Database
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
